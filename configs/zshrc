# Suppress zoxide doctor warnings
export _ZO_DOCTOR=0

# PATH (dedup + brew priority)
typeset -U PATH path
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:$HOME/bin:$PATH"

_mac_dev_has() {
  (( ${+commands[$1]} ))
}

# Zinit plugin manager (lazy-loaded)
ZINIT_HOME="$HOME/.local/share/zinit/zinit.git"
if [ -f "$ZINIT_HOME/zinit.zsh" ]; then
  source "$ZINIT_HOME/zinit.zsh"
  autoload -Uz _zinit
  (( ${+_comps} )) && _comps[zinit]=_zinit

  # Oh My Zsh plugins (eager-loaded to guarantee aliases/completions)
  zinit snippet OMZL::git.zsh
  zinit snippet OMZP::git
  zinit snippet OMZP::docker
  zinit snippet OMZP::kubectl

  # Visual enhancement plugins (lazy-loaded)
  zinit wait lucid for \
    light-mode zdharma-continuum/fast-syntax-highlighting \
    light-mode zsh-users/zsh-autosuggestions \
    light-mode zsh-users/zsh-completions
fi

# Starship prompt
_mac_dev_has starship && eval "$(starship init zsh)"

# Environment
if _mac_dev_has nvim; then
  export EDITOR="nvim"
else
  export EDITOR="vi"
fi
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Modern CLI aliases
if _mac_dev_has eza; then
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -la --icons --group-directories-first --git"
  alias lt="eza --tree --level=3 --icons"
fi
_mac_dev_has bat && alias cat="bat --paging=never"
_mac_dev_has fd && alias find="fd"
_mac_dev_has rg && alias grep="rg"
_mac_dev_has btop && alias top="btop"
_mac_dev_has dust && alias du="dust"
if _mac_dev_has nvim; then
  alias vim="nvim"
  alias vi="nvim"
fi
_mac_dev_has lazygit && alias lg="lazygit"
_mac_dev_has lazydocker && alias ld="lazydocker"
alias c="clear"
alias ..="cd .."
alias ...="cd ../.."

# fzf (fuzzy finder + Catppuccin Mocha theme)
if _mac_dev_has fzf; then
  source <(fzf --zsh)
  if _mac_dev_has fd; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi
  export FZF_DEFAULT_OPTS=" \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
    --color=selected-bg:#45475a \
    --border --border-label='' --preview-window='border-rounded' \
    --prompt='  ' --marker='>' --pointer='◆' \
    --separator='─' --scrollbar='│' --info='right'"
fi

# mise (runtime version manager — replaces nvm/asdf)
_mac_dev_has mise && eval "$(mise activate zsh)"

# direnv (per-project environment)
_mac_dev_has direnv && eval "$(direnv hook zsh)"

# atuin (SQLite-backed shell history — Ctrl+R / Up)
_mac_dev_has atuin && eval "$(atuin init zsh)"

# yazi — `y` instead of `yazi` so quitting with Q lands the shell in the
# directory you browsed to. Plain `yazi` still works and leaves $PWD alone.
if _mac_dev_has yazi; then
  function y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return 1
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# Tool launcher (fzf-based)
function tools() {
  _mac_dev_has fzf || return 1
  local cmds=()
  _mac_dev_has btop && cmds+=("btop:시스템 모니터링")
  _mac_dev_has lazygit && cmds+=("lazygit:Git UI")
  _mac_dev_has lazydocker && cmds+=("lazydocker:Docker UI")
  _mac_dev_has yazi && cmds+=("yazi:파일 매니저")
  _mac_dev_has dust && cmds+=("dust:폴더 크기 분석")
  _mac_dev_has procs && cmds+=("procs:프로세스 목록")
  (( ${#cmds[@]} > 0 )) || return 1

  local selected=$(printf '%s\n' "${cmds[@]}" | fzf --delimiter=: --with-nth=2 --height=40% --reverse --border --prompt="도구 선택: ")
  local cmd="${selected%%:*}"
  [[ -n "$cmd" ]] && _mac_dev_has "$cmd" && eval "$cmd"
}

# zoxide (smart cd — must be last)
_mac_dev_has zoxide && eval "$(zoxide init --cmd cd zsh)"

