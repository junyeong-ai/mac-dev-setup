# ── zoxide doctor 경고 억제 ──
export _ZO_DOCTOR=0

# ── PATH (중복 방지 + brew 우선) ──
typeset -U PATH path
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:$HOME/bin:$PATH"

# ── Oh My Zsh ──
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""          # Starship 사용하므로 비활성화
plugins=(git docker kubectl)
source "$ZSH/oh-my-zsh.sh"

# ── Starship 프롬프트 ──
eval "$(starship init zsh)"

# ── Zinit 플러그인 매니저 (지연 로딩) ──
if [ -f "$HOME/.local/share/zinit/zinit.git/zinit.zsh" ]; then
  source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
  autoload -Uz _zinit
  (( ${+_comps} )) && _comps[zinit]=_zinit

  zinit light zdharma-continuum/fast-syntax-highlighting
  zinit light zsh-users/zsh-autosuggestions
  zinit light zsh-users/zsh-completions
fi

# ── SCM Breeze (Claude Code 환경에서는 제외) ──
if [[ -z "$CLAUDECODE" ]]; then
  [ -s "$HOME/.scm_breeze/scm_breeze.sh" ] && source "$HOME/.scm_breeze/scm_breeze.sh"
fi

# ── 환경 설정 ──
export EDITOR="nvim"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# ── 모던 CLI Aliases ──
alias ls="eza --icons --group-directories-first"
alias ll="eza -la --icons --group-directories-first --git"
alias lt="eza --tree --level=3 --icons"
alias cat="bat --paging=never"
alias find="fd"
alias grep="rg"
alias top="btop"
alias df="duf"
alias du="dust"
alias vim="nvim"
alias vi="nvim"
alias lg="lazygit"
alias ld="lazydocker"
alias c="clear"
alias ..="cd .."
alias ...="cd ../.."

# ── fzf (퍼지 검색 + Catppuccin Mocha 테마) ──
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS=" \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
  --color=selected-bg:#45475a \
  --border --border-label='' --preview-window='border-rounded' \
  --prompt='  ' --marker='>' --pointer='◆' \
  --separator='─' --scrollbar='│' --info='right'"

# ── navi (치트시트 Ctrl+G) ──
eval "$(navi widget zsh)"

# ── mise (런타임 버전 관리 — nvm/asdf 대체) ──
eval "$(mise activate zsh)"

# ── 도구 런처 (fzf 기반) ──
function tools() {
  local cmds=(
    "btop:시스템 모니터링"
    "lazygit:Git UI"
    "lazydocker:Docker UI"
    "duf:디스크 사용량"
    "dust:폴더 크기 분석"
    "fastfetch:시스템 정보"
  )
  local selected=$(printf '%s\n' "${cmds[@]}" | fzf --delimiter=: --with-nth=2 --height=40% --reverse --border --prompt="도구 선택: ")
  local cmd="${selected%%:*}"
  [[ -n "$cmd" ]] && eval "$cmd"
}

# ── zoxide (스마트 cd — 반드시 맨 마지막) ──
eval "$(zoxide init --cmd cd zsh)"
